# Copia este archivo como .env (no se versiona) y cambia las contraseñas.
# Lo leen tanto Docker Compose (para crear la BD) como Next.js (para conectarse).

# --- MySQL en Docker ---
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
MYSQL_DATABASE=biblioteca
MYSQL_USER=biblioteca
MYSQL_PASSWORD=cambia-esta-clave

# --- Conexión desde la app ---
# Puerto 3307 en el host: el 3306 lo usa otro contenedor (dashboard-mariadb) en el portátil.
DB_HOST=127.0.0.1
DB_PORT=3307

# --- Autenticación ---
APP_URL=http://localhost:3000
# En producción, reemplázala por una clave aleatoria de al menos 32 bytes.
JWT_SECRET=cambia-por-una-clave-aleatoria-larga

# --- Solo para ejecutar pnpm admin:bootstrap; no se usa en la app ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=
ADMIN_APELLIDO=
# Opcional. Si se omite, el script usa la fecha actual en MySQL.
ADMIN_FECHA_CONTRATACION=
